{
  "manifest_version": 3,
  "name": "Eye2Serve Auto-Bidder - Rank 1",
  "version": "2.0",
  "description": "Automated bidding with AI CAPTCHA for Rank 1",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://www.eye2serve.com:9001/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.eye2serve.com:9001/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
